DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusphere"
AUTH_SECRET="change-me-to-a-long-random-string-32+chars"

# --- Parent alerts (optional). Without these, alerts are prepared for one-tap sending on WhatsApp. ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# DEFAULT_COUNTRY_CODE=91

# --- Phone push notifications (optional). Generate with: npm run vapid ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Owner tools (secret code + email gate). Generate the hash with: npm run owner-code ---
# OWNER_CODE_HASH=
# OWNER_EMAILS=you@example.com

# --- Razorpay (optional). Without these, billing runs in clearly-labelled demo mode (no real money). ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- WhatsApp Business Cloud API (Meta). Notifications to WhatsApp + replies synced into Messages. ---
# WHATSAPP_TOKEN=            (permanent System User access token)
# WHATSAPP_PHONE_ID=         (Phone number ID from the WhatsApp > API Setup page)
# WHATSAPP_DISPLAY_NUMBER=   (the number users message, digits with country code, e.g. 919876543210)
# WHATSAPP_APP_SECRET=       (Meta app secret, used to verify webhook signatures)
# WHATSAPP_VERIFY_TOKEN=     (any random string; paste the same into Meta's webhook setup)
# WHATSAPP_TEMPLATE=         (approved template name with two {{1}} {{2}} body variables, for messages outside the 24h window)
# WHATSAPP_TEMPLATE_LANG=en
