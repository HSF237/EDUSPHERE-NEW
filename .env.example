DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusphere"
AUTH_SECRET="change-me-to-a-long-random-string-32+chars"

# --- Parent alerts (optional). Without these, alerts are prepared for one-tap sending on WhatsApp. ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# DEFAULT_COUNTRY_CODE=91

# --- Phone push notifications (optional). Generate with: npm run vapid ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Owner tools (secret code + email gate). Generate the hash with: npm run owner-code ---
# OWNER_CODE_HASH=
# OWNER_EMAILS=you@example.com

# --- Razorpay (optional). Without these, billing runs in clearly-labelled demo mode (no real money). ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
